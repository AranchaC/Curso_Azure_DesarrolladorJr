@using WebApi_Concesionario.Models
@model IEnumerable<Concesionario>

@{
    ViewBag.Title = "Lista de Coches";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .table th, .table td {
            vertical-align: middle;
        }

        .table-striped {
            background-color: #f9f9f9;
        }

        .table th {
            background-color: #007bff;
            color: white;
        }

        .pagination .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
        }

        .pagination .page-item .page-link {
            color: #007bff;
        }

        .table td, .table th {
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container mt-4">
        <h1 class="text-center">@ViewBag.titulo</h1>

        <!-- Filtro de Búsqueda -->
        <div class="mb-4">
            <label for="search" class="form-label">Buscar por cualquier columna:</label>
            <input type="text" id="search" class="form-control" placeholder="Buscar..." />
        </div>

        <!-- Tabla de Coches -->
        <table class="table table-striped table-bordered" id="cochesTable">
            <thead>
                <tr>
                    <th>Id <button class="btn btn-light btn-sm" onclick="sortTable(0)">▲▼</button></th>
                    <th>Marca <button class="btn btn-light btn-sm" onclick="sortTable(1)">▲▼</button></th>
                    <th>Modelo <button class="btn btn-light btn-sm" onclick="sortTable(2)">▲▼</button></th>
                    <th>Precio <button class="btn btn-light btn-sm" onclick="sortTable(3)">▲▼</button></th>
                    <th>Descripción <button class="btn btn-light btn-sm" onclick="sortTable(4)">▲▼</button></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coche in Model)
                {
                    <tr>
                        <td>@coche.Id</td>
                        <td>@coche.Marca</td>
                        <td>@coche.Modelo</td>
                        <td>@coche.Precio</td>
                        <td>@coche.Descripcion</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Paginación -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </nav>
    </div>

    <!-- JavaScript para Filtrar, Ordenar y Paginación -->
    <script>
        let currentPage = 1;
        const rowsPerPage = 5;
        let filteredData = [];
        let originalData = [];

        // Obtener los datos de la tabla
        function getTableData() {
            const rows = Array.from(document.querySelectorAll('#cochesTable tbody tr'));
            originalData = rows.map(row => {
                return {
                    id: row.cells[0].textContent,
                    marca: row.cells[1].textContent,
                    modelo: row.cells[2].textContent,
                    precio: parseFloat(row.cells[3].textContent.replace(',', '').replace('€', '').trim()),
                    descripcion: row.cells[4].textContent,
                    row: row
                };
            });
            filteredData = [...originalData];
            paginate();
        }

        // Filtro de búsqueda
        document.getElementById('search').addEventListener('input', function() {
            const searchQuery = this.value.toLowerCase();
            filteredData = originalData.filter(item => {
                return Object.values(item).some(value => value.toString().toLowerCase().includes(searchQuery));
            });
            currentPage = 1;  // Reset to first page when searching
            paginate();
        });

        // Función para ordenar las columnas
        let sortDirection = [true, true, true, true, true];  // Para saber si estamos ordenando ascendente o descendente por cada columna
        function sortTable(columnIndex) {
            const isNumeric = columnIndex === 3;  // "Precio" es la columna numérica

            filteredData.sort((a, b) => {
                let valA = a[columnIndex];
                let valB = b[columnIndex];

                if (columnIndex === 3) {  // Si es la columna "Precio", ordenamos numéricamente
                    valA = parseFloat(valA);
                    valB = parseFloat(valB);
                }

                if (sortDirection[columnIndex]) {
                    if (valA > valB) return 1;
                    if (valA < valB) return -1;
                } else {
                    if (valA > valB) return -1;
                    if (valA < valB) return 1;
                }
                return 0;
            });

            sortDirection[columnIndex] = !sortDirection[columnIndex];  // Cambiar la dirección de ordenación para la próxima vez
            paginate();
        }

        // Función para manejar la paginación
        function paginate() {
            const totalPages = Math.ceil(filteredData.length / rowsPerPage);
            const start = (currentPage - 1) * rowsPerPage;
            const end = currentPage * rowsPerPage;

            // Limpiar la tabla
            const tbody = document.querySelector('#cochesTable tbody');
            tbody.innerHTML = '';

            // Añadir filas visibles a la tabla
            filteredData.slice(start, end).forEach(item => {
                tbody.appendChild(item.row);
            });

            // Generar la paginación
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            for (let i = 1; i <= totalPages; i++) {
                const pageItem = document.createElement('li');
                pageItem.classList.add('page-item');
                if (i === currentPage) pageItem.classList.add('active');
                pageItem.innerHTML = `<a class="page-link" href="#" onclick="goToPage(${i})">${i}</a>`;
                pagination.appendChild(pageItem);
            }
        }

        // Función para ir a la página
        function goToPage(page) {
            currentPage = page;
            paginate();
        }

        // Inicializar datos al cargar
        window.onload = getTableData;

    </script>

</body>
</html>
