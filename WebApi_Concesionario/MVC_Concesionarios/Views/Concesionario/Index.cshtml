@using WebApi_Concesionario.Models
@model IEnumerable<Concesionario>

@{
    ViewBag.Title = "Lista de Coches";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        /* Estilos adicionales */
        .table th, .table td {
            vertical-align: middle;
        }
        .table-striped {
            background-color: #f9f9f9;
        }
        .table th {
            background-color: #007bff;
            color: white;
        }
        .pagination .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
        }
        .pagination .page-item .page-link {
            color: #007bff;
        }
        .table td, .table th {
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container mt-4">
        <h1 class="text-center">@ViewBag.titulo</h1>

        <!-- Filtro de Búsqueda -->
        <div class="mb-4">
            <label for="search" class="form-label">Buscar por cualquier columna:</label>
            <input type="text" id="search" class="form-control" placeholder="Buscar..." />
        </div>

        <!-- Tabla de Coches -->
        <table class="table table-striped table-bordered" id="cochesTable">
            <thead>
                <tr>
                    <th>Id <button class="btn btn-light btn-sm" onclick="sortTable(0)">▲▼</button></th>
                    <th>Marca <button class="btn btn-light btn-sm" onclick="sortTable(1)">▲▼</button></th>
                    <th>Modelo <button class="btn btn-light btn-sm" onclick="sortTable(2)">▲▼</button></th>
                    <th>Precio <button class="btn btn-light btn-sm" onclick="sortTable(3)">▲▼</button></th>
                    <th>Descripción <button class="btn btn-light btn-sm" onclick="sortTable(4)">▲▼</button></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coche in Model)
                {
                    <tr>
                        <td>@coche.Id</td>
                        <td>@coche.Marca</td>
                        <td>@coche.Modelo</td>
                        <td>@coche.Precio</td>
                        <td>@coche.Descripcion</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Paginación -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <!-- Paginación dinámica será generada por JavaScript -->
            </ul>
        </nav>
    </div>

    <!-- JavaScript para Filtrar, Ordenar y Paginación -->
    <script>
        let currentPage = 1;
        const rowsPerPage = 5;

        // Filtro de búsqueda en cada columna
        document.getElementById('search').addEventListener('input', function() {
            const searchQuery = this.value.toLowerCase();
            filterTable(searchQuery);
        });

        // Función para filtrar la tabla
        function filterTable(query) {
            const rows = document.querySelectorAll('#cochesTable tbody tr');
            rows.forEach(row => {
                let match = false;
                row.querySelectorAll('td').forEach(cell => {
                    if (cell.textContent.toLowerCase().includes(query)) {
                        match = true;
                    }
                });
                row.style.display = match ? '' : 'none';
            });
            paginate();
        }

        // Función para ordenar las columnas
        function sortTable(columnIndex) {
            const table = document.getElementById('cochesTable');
            const rows = Array.from(table.rows).slice(1); // Skip the header row
            const isAsc = table.rows[0].cells[columnIndex].classList.contains('asc');

            rows.sort((a, b) => {
                const cellA = a.cells[columnIndex].textContent.trim();
                const cellB = b.cells[columnIndex].textContent.trim();
                return isAsc ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
            });

            rows.forEach(row => table.appendChild(row)); // Append the rows back to the table

            // Toggle sort class
            table.rows[0].cells[columnIndex].classList.toggle('asc', !isAsc);
            table.rows[0].cells[columnIndex].classList.toggle('desc', isAsc);
        }

        // Función para manejar la paginación
        function paginate() {
            const table = document.getElementById('cochesTable');
            const rows = Array.from(table.rows).slice(1);
            const filteredRows = rows.filter(row => row.style.display !== 'none');
            const totalPages = Math.ceil(filteredRows.length / rowsPerPage);

            // Limitar filas a la página actual
            const start = (currentPage - 1) * rowsPerPage;
            const end = currentPage * rowsPerPage;
            filteredRows.slice(start, end).forEach(row => row.style.display = '');

            // Ocultar las filas que no están en la página actual
            filteredRows.forEach((row, index) => {
                if (index < start || index >= end) {
                    row.style.display = 'none';
                }
            });

            // Generar la paginación
            const pagination = document.querySelector('.pagination');
            pagination.innerHTML = '';
            for (let i = 1; i <= totalPages; i++) {
                const pageItem = document.createElement('li');
                pageItem.classList.add('page-item');
                if (i === currentPage) pageItem.classList.add('active');
                pageItem.innerHTML = `<a class="page-link" href="#" onclick="goToPage(${i})">${i}</a>`;
                pagination.appendChild(pageItem);
            }
        }

        // Función para ir a la página
        function goToPage(page) {
            currentPage = page;
            paginate();
        }

        // Inicializar la paginación
        window.onload = paginate;
    </script>

</body>
</html>
